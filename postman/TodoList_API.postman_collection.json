{
  "info": {
    "name": "ToDo List API",
    "description": "RESTful API for managing projects and tasks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/projects",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects"]
            }
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Project\",\n  \"description\": \"Project description\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects"]
            }
          }
        },
        {
          "name": "Get Project",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}"]
            }
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Project\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}"]
            }
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "tasks"]
            }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Task\",\n  \"description\": \"Task description\",\n  \"status\": \"todo\",\n  \"deadline\": \"2025-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "tasks"]
            }
          }
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Task\",\n  \"description\": \"Updated description\",\n  \"status\": \"doing\",\n  \"deadline\": \"2025-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "Change Task Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/tasks/{{task_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "tasks", "{{task_id}}", "status"]
            }
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "tasks", "{{task_id}}"]
            }
          }
        }
      ]
    }
  ]
}
