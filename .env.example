# Database Configuration
POSTGRES_USER=todolist
POSTGRES_PASSWORD=todolist
POSTGRES_DB=todolist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (constructed from above or set directly)
DATABASE_URL=postgresql://todolist:todolist@localhost:5432/todolist

# Application Limits
MAX_NUMBER_OF_PROJECTS=10
MAX_NUMBER_OF_TASKS_PER_PROJECT=50
MAX_PROJECT_NAME_CHARS=30
MAX_PROJECT_DESCRIPTION_CHARS=150
MAX_TASK_TITLE_CHARS=30
MAX_TASK_DESCRIPTION_CHARS=150
